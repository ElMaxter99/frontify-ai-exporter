# ---- Frontify connection (credentials ONLY via environment, never in the frontend) ----
# Your Frontify domain, e.g. acme.frontify.com (no https://)
FRONTIFY_DOMAIN=
# Personal access token or OAuth2 access token. Sent as "Authorization: Bearer <token>".
FRONTIFY_TOKEN=

# ---- Paths ----
EXPORT_DIR=./exports
DATA_DIR=./data

# ---- Performance ----
DOWNLOAD_CONCURRENCY=4
API_CONCURRENCY=4
PAGE_SIZE=50
REQUEST_TIMEOUT=60
MAX_RETRIES=5

# ---- AI preparation (all optional) ----
# none | openai | local
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=
OPENAI_API_KEY=
# sqlite (built-in) | chroma | faiss | qdrant
VECTOR_STORE=sqlite
QDRANT_URL=http://localhost:6333
OCR_ENABLED=false

LOG_LEVEL=INFO
